{
  "name": "@d3r/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./schema.ts",
  "types": "./schema.ts",
  "exports": {
    ".": "./schema.ts",
    "./result": "./result.ts",
    "./runtime": "./runtime.ts",
    "./spawn": "./spawn.ts",
    "./vault/*": "./vault/*.ts"
  },
  "files": [
    "agents/**",
    "schema.ts",
    "result.ts",
    "runtime.ts",
    "spawn.ts",
    "seed/**",
    "vault/**",
    "workflow.yaml",
    "tsconfig*.json",
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/seed && cp -r seed dist/seed",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2",
    "zod": "^3"
  }
}
