{
  "name": "@d3r/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./schema.ts",
  "types": "./schema.ts",
  "exports": {
    ".": "./schema.ts",
    "./model-config": "./model-config.ts",
    "./engine": "./engine.ts",
    "./package.json": "./package.json",
    "./result": "./result.ts",
    "./runtime": "./runtime.ts",
    "./spawn": "./spawn.ts",
    "./vault/*": "./vault/*.ts"
  },
  "files": [
    "agents/**",
    "schema.ts",
    "model-config.ts",
    "engine.ts",
    "result.ts",
    "runtime.ts",
    "spawn.ts",
    "seed/**",
    "vault/**",
    "workflow.yaml",
    "tsconfig*.json",
    "dist/**"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/schema.js",
    "types": "./dist/schema.d.ts",
    "exports": {
      ".": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "./model-config": {
        "types": "./dist/model-config.d.ts",
        "default": "./dist/model-config.js"
      },
      "./engine": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "./package.json": "./package.json",
      "./result": {
        "types": "./dist/result.d.ts",
        "default": "./dist/result.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./spawn": {
        "types": "./dist/spawn.d.ts",
        "default": "./dist/spawn.js"
      },
      "./vault/*": {
        "types": "./dist/vault/*.d.ts",
        "default": "./dist/vault/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/seed && cp -r seed dist/seed",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2",
    "zod": "^3"
  }
}
