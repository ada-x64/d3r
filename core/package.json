{
  "name": "@d3r/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./schema.ts",
  "types": "./schema.ts",
  "exports": {
    ".": "./schema.ts",
    "./vault/*": "./vault/*.ts"
  },
  "files": [
    "agents/**",
    "schema.ts",
    "scripts/**",
    "seed/**",
    "vault/**",
    "workflow.yaml",
    "tsconfig*.json",
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-seed.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2",
    "zod": "^3"
  }
}
