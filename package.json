{
  "name": "d3r",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "tsc --noEmit && pnpm -r check",
    "build:legacy": "tsx scripts/build.ts",
    "lint": "oxlint --deny-warnings",
    "lint:md": "markdownlint-cli2",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "test:dist": "vitest --run --project=dist --passWithNoTests",
    "test:coverage": "vitest --run --coverage --passWithNoTests",
    "cli": "pnpm -r build && node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.4",
    "gray-matter": "^4",
    "markdownlint-cli2": "^0.22.1",
    "memfs": "^4",
    "msw": "^2",
    "oxlint": "^1.61.0",
    "prettier": "^3.8.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "yaml": "^2",
    "zod": "^3"
  }
}
