{
  "name": "@d3r/adapter-acp",
  "version": "0.0.0",
  "type": "module",
  "main": "./runtime.ts",
  "types": "./runtime.ts",
  "exports": {
    ".": "./runtime.ts",
    "./server": "./server.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/runtime.js",
    "types": "./dist/runtime.d.ts",
    "exports": {
      ".": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "acp",
    "agent-client-protocol"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@d3r/core": "workspace:*",
    "pi-acp": "0.0.33",
    "zod": "^3"
  }
}
