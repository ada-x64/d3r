{
  "name": "@d3r/adapter-pi",
  "version": "0.0.0",
  "type": "module",
  "main": "./compile.ts",
  "types": "./compile.ts",
  "exports": {
    ".": "./compile.ts",
    "./runtime": "./runtime.ts",
    "./embedded": "./embedded.ts",
    "./auth": "./auth.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "extensions/**"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/compile.js",
    "types": "./dist/compile.d.ts",
    "exports": {
      ".": {
        "types": "./dist/compile.d.ts",
        "default": "./dist/compile.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./embedded": {
        "types": "./dist/embedded.d.ts",
        "default": "./dist/embedded.js"
      },
      "./auth": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/d3r-tools",
      "./extensions/mode",
      "./extensions/subagent"
    ]
  },
  "scripts": {
    "prebuild": "tsx scripts/build.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@d3r/core": "workspace:*",
    "@d3r/tools": "workspace:*",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "gray-matter": "^4",
    "proper-lockfile": "4.1.2",
    "yaml": "^2",
    "zod": "^3",
    "zod-to-json-schema": "3.25.1"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4"
  }
}
