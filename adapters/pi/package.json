{
  "name": "@d3r/adapter-pi",
  "version": "0.0.0",
  "type": "module",
  "main": "./compile.ts",
  "types": "./compile.ts",
  "exports": {
    ".": "./compile.ts",
    "./runtime": "./runtime.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/d3r-tools",
      "./extensions/mode",
      "./extensions/subagent"
    ]
  },
  "scripts": {
    "prebuild": "tsx scripts/build.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@d3r/core": "workspace:*",
    "@d3r/tools": "workspace:*",
    "gray-matter": "^4",
    "yaml": "^2",
    "zod": "^3"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  }
}
