{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["build.ts", "core/**/*.ts", "adapters/**/*.ts"],
  "exclude": ["adapters/pi/extensions/subagent/**", "adapters/pi/extensions/mode/**"]
}
