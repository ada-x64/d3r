{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": [
    "adapters/pi/extensions/subagent/**",
    "adapters/pi/extensions/mode/**",
    "adapters/pi/extensions/d3r-tools/**"
  ]
}
